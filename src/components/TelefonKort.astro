---
import Card from "./Card.astro";

interface Props {
    phone?: string;
    sentralbordTekst?: string;
    minHeight?: string;
}

const { phone = '', sentralbordTekst, minHeight } = Astro.props;
const cleanPhone = phone.replace(/\s+/g, '');

// Mobil: hele kortet er én tel:-lenke (stor treffflate). Desktop: ikke-interaktivt kort,
// samme mønster som TelefonKnapp.astro. Mangler nummeret: ett kort uten lenke, aldri href="tel:".
const variants: { href?: string; class?: string }[] = cleanPhone
    ? [{ href: `tel:${cleanPhone}`, class: 'lg:hidden' }, { class: 'max-lg:hidden' }]
    : [{}];
---
{variants.map(({ href, class: className }) => (
    <Card index="4" title="Telefon" minHeight={minHeight} href={href} class={className}>
        <svg slot="icon"
             xmlns="http://www.w3.org/2000/svg"
             width="32"
             height="32"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l2.21-2.21a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        {/* Ren tekst: en <a> inne i kort-lenka ville vært nestet og splittet av HTML-parseren. */}
        <p class="whitespace-nowrap">{phone}</p>
        <p class="text-xs">{sentralbordTekst}</p>

        {href && (
            <div slot="link">
                <div class="card-link">
                    Ring oss <span aria-hidden="true" class="ml-2 transition-transform group-hover:translate-x-1 inline-block">→</span>
                </div>
            </div>
        )}
    </Card>
))}
